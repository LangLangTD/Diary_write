# ---- 发布签名：绝对不能提交 ----
# key.properties 里有 keystore 密码，keystore/ 里是应用签名密钥。
# 签名密钥泄露 = 别人可以签出系统认为是你这个 app 的升级包。
android/key.properties
android/keystore/
*.jks
*.keystore
*.p12

# ---- 构建产物 ----
# dist/ 里是 100+MB 的安装包，用 Flutter 命令重新构建即可
/dist/
*.apk
*.exe
*.zip

# ---- 环境相关 ----
android/local.properties
android/.gradle/
android/.kotlin/